# Copy this file to .env and fill real values locally or on the server.

HOST=0.0.0.0
PORT=80

# Comma-separated theme IDs. Empty or omitted enables all themes.
# classic is always available; ENABLED_THEMES=classic hides the theme menu.
# IDs: classic,winter,spring,summer,autumn,67,magic,hello-kitty,548,robo548,minions
ENABLED_THEMES=

# Local statistics, publication dates, and private feedback databases (SQLite).
DATA_DIR=./data

# Enables article feedback and the private /admin/feedback page.
# Use a long unique password. Empty means feedback is disabled.
ADMIN_PASSWORD=

# One password per protected category. Category slug is uppercased and
# non-alphanumeric characters are replaced with underscores.
#
# Examples:
# articles/10-3D             -> ARTICLE_PASSWORD_10_3D
# articles/05-knowledge-base -> ARTICLE_PASSWORD_05_KNOWLEDGE_BASE
ARTICLE_PASSWORD_10_3D=change-me
