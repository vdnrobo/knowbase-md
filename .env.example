# Copy this file to .env and fill real values locally or on the server.

HOST=0.0.0.0
PORT=80

# One password per protected category. Category slug is uppercased and
# non-alphanumeric characters are replaced with underscores.
#
# Examples:
# articles/10-3D             -> ARTICLE_PASSWORD_10_3D
# articles/05-knowledge-base -> ARTICLE_PASSWORD_05_KNOWLEDGE_BASE
ARTICLE_PASSWORD_10_3D=change-me
